<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CoachMarkSample.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CoachMarkSample"
    FlyoutBehavior="Flyout"
    Title="CoachMarkSample">

    <FlyoutItem Title="Showcase" FlyoutDisplayOptions="AsSingleItem">
        <Tab Title="Home" Route="HomeTab" Icon="tab_home.png">
            <ShellContent
                Title="Home"
                Icon="tab_home.png"
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>
        <Tab Title="Details" Route="DetailsTab" Icon="tab_details.png">
            <ShellContent
                Title="Details"
                Icon="tab_details.png"
                ContentTemplate="{DataTemplate local:DetailsPage}"
                Route="DetailsPage" />
        </Tab>
        <Tab Title="Explore" Route="ExploreTab" Icon="tab_explore.png">
            <ShellContent
                Title="Explore"
                Icon="tab_explore.png"
                ContentTemplate="{DataTemplate local:DetailsPage}"
                Route="ExplorePage" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="About">
        <ShellContent
            Title="About"
            ContentTemplate="{DataTemplate local:DetailsPage}"
            Route="AboutPage" />
    </FlyoutItem>

</Shell>
